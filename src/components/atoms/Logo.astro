---
interface Props {
  href?: string;
}
const { href = '#top' } = Astro.props;
---
<a class="logo" href={href}>
  <span class="logo-bar"></span>
  <span class="logo-stack">
    <span class="logo-line">
      <span class="logo-word">Délices</span>
      <span class="logo-name">Istanbul</span>
    </span>
    <span class="logo-sub">Depuis 2010 — Bondy</span>
  </span>
</a>

<style>
.logo { display: flex; align-items: center; gap: clamp(8px, 1.5vw, 12px); color: var(--color-text-on-dark); }
.logo:hover { color: var(--color-text-on-dark); }
.logo-bar { width: 3px; height: 36px; flex: none; background: var(--color-primary); }
.logo-stack { display: flex; flex-direction: column; gap: clamp(2px, 0.5vw, 3px); line-height: 1; }
.logo-line { display: flex; align-items: baseline; gap: clamp(6px, 1.2vw, 8px); }
.logo-word { font-family: var(--font-family-brand); font-size: clamp(13px, 1.1vw, 15px); font-weight: 600; color: var(--color-primary-light); }
.logo-name { font-family: var(--font-family-display); font-size: clamp(18px, 2vw, 24px); text-transform: uppercase; letter-spacing: .03em; color: var(--color-cream); }
.logo-sub { font-size: clamp(9px, 1vw, 10px); font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--color-grey); }
@media (max-width: 520px) { .logo-sub { display: none; } }
</style>