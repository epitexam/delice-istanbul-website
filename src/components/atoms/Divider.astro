---
interface Props {
  color?: 'light' | 'dark';
}
const { color = 'dark' } = Astro.props;
---
<hr class={`divider divider--${color}`} />

<style>
.divider {
  border: none;
  margin: 0;
}
.divider--dark {
  border-bottom: 2px solid var(--color-border-dark);
}
.divider--light {
  border-bottom: 2px solid var(--color-border-ink-25);
}
</style>