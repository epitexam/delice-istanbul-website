---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  /** Échelle typographique, indépendante du niveau sémantique. */
  size?: 'hero' | 'default' | 'panel' | 'address';
  /** `cream` force la couleur claire sur les fonds rouges ou encrés. */
  tone?: 'inherit' | 'cream';
  class?: string;
}
const {
  level = 2,
  size = level === 1 ? 'hero' : 'default',
  tone = 'inherit',
  class: className,
} = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
---

<Tag class:list={['heading', `heading--${size}`, `heading--tone-${tone}`, className]}>
  <slot />
</Tag>

<style>
  .heading {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.98;
  }
  .heading--hero {
    font-size: var(--font-size-hero);
    line-height: 0.86;
    letter-spacing: 0.005em;
    color: var(--color-cream);
    text-shadow: 0 clamp(4px, 1vw, 6px) 0 var(--color-border-ink-22);
  }
  .heading--default {
    font-size: var(--font-size-title);
  }
  /* Titre du panneau « Horaires » : plus compact que le titre courant. */
  .heading--panel {
    font-size: var(--font-size-title-panel);
    line-height: 0.95;
  }
  /* Titre de la section « Nous trouver ». */
  .heading--address {
    font-size: var(--font-size-title-address);
  }
  .heading--tone-cream {
    color: var(--color-cream);
  }
</style>
