---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
  style?: string;
}
const { level = 2, class: className = "", style = "" } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
---

<Tag class:list={["heading", `heading--${level}`, className]} style={style}>
  <slot />
</Tag>

<style>
  .heading {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.98;
  }
  .heading--1 {
    font-size: var(--font-size-hero);
    line-height: 0.86;
    letter-spacing: 0.005em;
    color: var(--color-cream);
    text-shadow: 0 6px 0 rgba(22, 17, 15, .22);
  }
  .heading--2 {
    font-size: var(--font-size-title);
  }
  .heading--3 {
    font-size: var(--font-size-4xl);
  }
  .heading--4 {
    font-size: var(--font-size-3xl);
  }
  .heading--5 {
    font-size: var(--font-size-2xl);
  }
  .heading--6 {
    font-size: var(--font-size-xl);
  }
</style>