---
interface Props {
  href: string;
}
const { href } = Astro.props;
---
<a class="nav-phone" href={href}>
  <slot />
</a>

<style>
.nav-phone {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 11px 20px;
  background: var(--color-primary);
  color: var(--color-cream);
  font-weight: 600;
  letter-spacing: .1em;
  border-radius: 2px;
  transition: background var(--transition-fast);
  font-size: 12px;
}
.nav-phone:hover {
  background: var(--color-primary-hover);
  color: var(--color-cream);
}
@media (max-width: 520px) {
  .nav-phone { padding: 10px 14px; font-size: 11px; }
}
</style>