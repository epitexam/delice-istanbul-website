---
interface Props {
  as?: 'p' | 'span' | 'div';
  size?: 'xs' | 'sm' | 'base' | 'lg' | 'xl';
  color?: 'light' | 'dark' | 'muted' | 'primary';
  class?: string;
}
const { as: Tag = 'p', size = 'base', color = 'light', class: className = '' } = Astro.props;
---
<Tag class={`text text--${size} text--${color} ${className}`}>
  <slot />
</Tag>

<style>
.text {
  margin: 0;
  font-family: var(--font-family-body);
  line-height: var(--line-height-base);
}
.text--xs { font-size: var(--font-size-xs); }
.text--sm { font-size: var(--font-size-sm); }
.text--base { font-size: var(--font-size-base); }
.text--lg { font-size: var(--font-size-lg); }
.text--xl { font-size: var(--font-size-xl); }
.text--light { color: var(--color-text-on-dark); }
.text--dark { color: var(--color-text-on-light); }
.text--muted { color: var(--color-text-muted-on-light); }
.text--primary { color: var(--color-primary); }
</style>