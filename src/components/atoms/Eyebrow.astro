---
interface Props {
  variant?: 'dark' | 'red';
  size?: 'default' | 'hero';
}
const { variant = 'dark', size = 'default' } = Astro.props;
---
<span class={`eyebrow eyebrow--${variant} eyebrow--size-${size}`}>
  <slot />
</span>

<style>
.eyebrow {
  display: inline-block;
  font-weight: 600;
  letter-spacing: .22em;
  text-transform: uppercase;
}
.eyebrow--size-default {
  padding: clamp(5px, 1vw, 6px) clamp(10px, 1.2vw, 13px);
  font-size: clamp(9px, 1vw, 10px);
  margin-bottom: 18px;
}
.eyebrow--size-hero {
  padding: clamp(6px, 1.2vw, 8px) clamp(12px, 1.5vw, 16px);
  font-size: clamp(10px, 1.1vw, 11px);
  margin-bottom: 32px;
  white-space: nowrap;
}
.eyebrow--dark {
  background: var(--color-ink);
  color: var(--color-cream);
}
.eyebrow--red {
  background: var(--color-red);
  color: var(--color-text-on-red);
}
</style>