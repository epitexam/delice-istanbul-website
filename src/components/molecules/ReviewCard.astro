---
interface Props {
  stars: number;
  quote: any;
  author: any;
}
const { stars, quote, author } = Astro.props;
---
<figure class="review">
  <span class="review-stars">{'★'.repeat(stars)}{'☆'.repeat(5 - stars)}</span>
  <blockquote>{quote}</blockquote>
  <figcaption>{author}</figcaption>
</figure>

<style>
.review {
  margin: 0;
  padding: clamp(18px, 3vw, 28px) clamp(16px, 3vw, 26px);
  background: var(--color-ink);
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.review-stars {
  color: var(--color-red-light);
  font-size: 14px;
  letter-spacing: 3px;
}
.review blockquote {
  margin: 0;
  font-size: clamp(15px, 1.2vw, 18px);
  line-height: 1.55;
  color: var(--color-cream);
}
.review figcaption {
  margin-top: auto;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--color-text-faint);
}
</style>