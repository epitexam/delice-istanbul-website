---
import LanguageButton from "../atoms/LanguageButton.astro";
---

<span class="lang-switch">
  <LanguageButton for="lang-fr">FR</LanguageButton>
  <LanguageButton for="lang-en">EN</LanguageButton>
</span>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 10px;
    border-left: 1px solid var(--color-border-light);
  }

  @media (max-width: 900px) {
    .lang-switch {
      border-left: none;
      border-top: 1px solid var(--color-border-light);
      padding-left: 0;
      padding-top: 20px;
      margin-top: 4px;
    }
  }
</style>
