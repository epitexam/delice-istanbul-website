---
import Heading from "../atoms/Heading.astro";
import Eyebrow from "../atoms/Eyebrow.astro";
import FeatureCard from "../molecules/FeatureCard.astro";
---

<section class="section section--ink" id="cuisine">
  <div class="wrap">
    <div class="section-head">
      <Eyebrow>
        <span class="i18n fr">Notre cuisine</span>
        <span class="i18n en">Our food</span>
      </Eyebrow>
      <Heading level={2}>
        <span class="i18n fr"
          >Trois bonnes raisons<br />de pousser la porte</span
        >
        <span class="i18n en">Three good reasons<br />to step inside</span>
      </Heading>
    </div>

    <div class="cards">
      <FeatureCard
        kicker={(
          <>
            <span class="i18n fr">Grillades</span>
            <span class="i18n en">Grill</span>
          </>
        )}
        title={(
          <>
            <span class="i18n fr">Le charbon, rien d'autre</span>
            <span class="i18n en">Charcoal, nothing else</span>
          </>
        )}
        text={(
          <>
            <span class="i18n fr">
              Kebabs, brochettes et grillades préparées à la minute. La viande
              est marinée chez nous, jamais la veille pour le lendemain.
            </span>
            <span class="i18n en">
              Kebabs, skewers and grills cooked to order. We marinate the meat
              ourselves, fresh every day.
            </span>
          </>
        )}
        imageAlt={(
          <>
            <span class="i18n fr">Photo — viande sur le grill</span>
            <span class="i18n en">Photo — meat on the grill</span>
          </>
        )}
      />
      <FeatureCard
        kicker="Halal"
        title={(
          <>
            <span class="i18n fr">Une cuisine 100 % halal</span>
            <span class="i18n en">100% halal kitchen</span>
          </>
        )}
        text={(
          <>
            <span class="i18n fr">
              Toute notre viande est certifiée halal. Vous mangez tranquille,
              sans avoir à poser la question.
            </span>
            <span class="i18n en">
              All of our meat is halal certified, so you can eat with complete
              peace of mind.
            </span>
          </>
        )}
        imageAlt={(
          <>
            <span class="i18n fr">Photo — plat servi à table</span>
            <span class="i18n en">Photo — a plate at the table</span>
          </>
        )}
      />
      <FeatureCard
        kicker={(
          <>
            <span class="i18n fr">À emporter</span>
            <span class="i18n en">Takeaway</span>
          </>
        )}
        title={(
          <>
            <span class="i18n fr">Prêt en quelques minutes</span>
            <span class="i18n en">Ready in minutes</span>
          </>
        )}
        text={(
          <>
            <span class="i18n fr">
              Un appel avant de partir du travail, et votre commande vous
              attend, chaude, emballée, prête à partir.
            </span>
            <span class="i18n en">
              One call before you leave work and your order is waiting — hot,
              wrapped and ready to go.
            </span>
          </>
        )}
        imageAlt={(
          <>
            <span class="i18n fr">Photo — commande à emporter</span>
            <span class="i18n en">Photo — takeaway order</span>
          </>
        )}
      />
    </div>
  </div>
</section>

<style>
  .section-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(40px, 5vw, 64px);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: clamp(20px, 2.6vw, 30px);
  }
</style>
