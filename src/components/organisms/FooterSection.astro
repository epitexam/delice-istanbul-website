<style>
.site-footer {
  padding: clamp(36px, 7vw, 80px) clamp(16px, 5vw, 64px) clamp(20px, 4vw, 30px);
  background: var(--color-red);
  color: var(--color-cream);
}
.footer-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
  gap: 32px;
  align-items: start;
}
.footer-logo {
  display: flex;
  align-items: baseline;
  gap: 7px;
}
.footer-logo-word {
  font-family: var(--font-family-brand);
  font-size: 16px;
  font-weight: 600;
  color: var(--color-ink);
}
.footer-logo-name {
  font-family: var(--font-family-display);
  font-size: 28px;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: var(--color-cream);
}
.footer-text {
  margin: 12px 0 0;
  font-size: 14px;
  line-height: 1.65;
}
.footer-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 9px;
  font-size: 14px;
}
.footer-head {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--color-ink);
  margin-bottom: 4px;
}
.footer-link {
  color: var(--color-cream);
  align-self: flex-start;
  border-bottom: 1px solid var(--color-shadow-cream-light-50);
  word-break: break-all;
}
.footer-link:hover {
  color: var(--color-ink);
  border-color: var(--color-ink);
}
.footer-bottom {
  margin-top: 30px;
  padding-top: 16px;
  border-top: 2px solid var(--color-border-ink-25);
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: space-between;
  font-size: 11px;
  font-weight: 600;
  text-align: center;
}
@media (max-width: 768px) {
  .footer-bottom {
    justify-content: center;
    gap: 8px;
  }
}
</style>