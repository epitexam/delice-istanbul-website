---
import Heading from '../atoms/Heading.astro';
import ScriptText from '../atoms/ScriptText.astro';
import Eyebrow from '../atoms/Eyebrow.astro';
---
<section class="hero" id="top">
  <div class="hero-texture"></div>
  <div class="hero-glow"></div>

  <div class="hero-grid">
    <div class="col">
      <Eyebrow size="hero">
        <span class="i18n fr">Restaurant turc · Bondy</span>
        <span class="i18n en">Turkish restaurant · Bondy</span>
      </Eyebrow>

      <div style="position:relative">
        <Heading level={1}>Délices<br>Istanbul</Heading>
        <ScriptText size="hero" color="ink" nowrap>100% halal</ScriptText>
      </div>

      <p class="hero-lede">
        <span class="i18n fr">Grillades au charbon, pain sorti du four, épices d'Anatolie — une cuisine turque simple et généreuse, à deux pas du centre de Bondy.</span>
        <span class="i18n en">Charcoal grills, bread straight from the oven, Anatolian spices — simple, generous Turkish cooking in the heart of Bondy.</span>
      </p>

      <div class="hero-actions">
        <a class="btn-order" href="tel:+33148474526">
          <span class="i18n fr">Commander · 01 48 47 45 26</span>
          <span class="i18n en">Order · +33 1 48 47 45 26</span>
        </a>
        <a class="btn-ghost" href="#adresse">
          <span class="i18n fr">Nous trouver</span>
          <span class="i18n en">Find us</span>
        </a>
      </div>

      <div class="hero-note">
        <span class="i18n fr">Ouvert 7j/7 · 11h00 – 23h30 · sur place &amp; à emporter</span>
        <span class="i18n en">Open 7 days · 11:00 AM – 11:30 PM · eat in &amp; takeaway</span>
      </div>
    </div>

    <div class="hero-media">
      <div class="hero-frame">
        <div class="photo">
          <p class="photo-hint">Photo du plat signature sur fond neutre — kebab, assiette grillades…</p>
        </div>
      </div>
      <div class="hero-stamp">
        <div class="hero-stamp-main">100% Halal</div>
        <div class="hero-stamp-sub">Depuis 2010</div>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  background: var(--color-red);
  overflow: hidden;
  padding: clamp(120px, 13vw, 170px) clamp(16px, 5vw, 64px) clamp(48px, 7vw, 84px);
}
.hero-texture {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: .5;
  background-image: repeating-linear-gradient(58deg, rgba(22,17,15,.13) 0 2px, transparent 2px 26px);
}
.hero-glow {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: radial-gradient(90% 70% at 12% 10%, rgba(255,255,255,.1) 0%, transparent 60%),
              radial-gradient(80% 80% at 100% 100%, rgba(22,17,15,.28) 0%, transparent 65%);
}
.hero-grid {
  position: relative;
  z-index: 1;
  max-width: var(--container-max-width);
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
  gap: clamp(30px, 4vw, 56px);
  align-items: center;
  animation: riseIn .8s ease both;
}
.hero-lede {
  display: inline-block;
  max-width: 46ch;
  margin: 26px 0 0;
  padding: 16px 20px;
  background: var(--color-ink);
  color: #eae0d2;
  font-size: clamp(14px, 1.2vw, 16px);
  line-height: 1.6;
}
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  margin-top: 30px;
}
.btn-order {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 18px 34px;
  background: var(--color-ink);
  color: var(--color-cream);
  font-family: var(--font-family-display);
  font-size: clamp(15px, 1.5vw, 19px);
  letter-spacing: .06em;
  text-transform: uppercase;
  box-shadow: var(--shadow-heavy);
  transition: background var(--transition-fast), color var(--transition-fast);
}
.btn-order:hover {
  background: var(--color-cream);
  color: var(--color-red);
}
.btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 4px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--color-cream);
  border-bottom: 2px solid rgba(249, 241, 228, .55);
  transition: color var(--transition-fast), border-color var(--transition-fast);
}
.btn-ghost:hover {
  color: var(--color-ink);
  border-color: var(--color-ink);
}
.hero-note {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 26px;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: .06em;
  color: #fbe6df;
}
.hero-media {
  position: relative;
  min-width: 0;
}
.hero-frame {
  position: relative;
  height: clamp(320px, 42vw, 520px);
  overflow: hidden;
  border: 3px solid var(--color-ink);
  box-shadow: 12px 12px 0 rgba(22,17,15,.3);
}
.hero-stamp {
  position: absolute;
  left: -16px;
  bottom: -22px;
  padding: 12px 18px 13px;
  background: var(--color-ink);
  color: var(--color-cream);
  border: 3px solid var(--color-cream);
  box-shadow: 8px 8px 0 rgba(22,17,15,.32);
  transform: rotate(-3deg);
  text-align: center;
}
.hero-stamp-main {
  font-family: var(--font-family-display);
  font-size: 26px;
  line-height: .95;
  letter-spacing: .02em;
  text-transform: uppercase;
}
.hero-stamp-sub {
  margin-top: 5px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: var(--color-red-light);
}
@media (max-width: 520px) {
  .hero-stamp {
    left: 0;
    bottom: -16px;
  }
}
</style>